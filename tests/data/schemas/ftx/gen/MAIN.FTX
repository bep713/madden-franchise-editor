<?xml version="1.0" encoding="utf-8"?>
<!-- Entry: includes Enums before Teams, because generateSchemaV2 resolves an
     attribute's enum at parse time (enumMap[type]) and includes parse first,
     in document order. -->
<FranTkData databaseName="Madden27_Franchise" dataMajorVersion="900" dataMinorVersion="1">
  <Includes>
    <IncludeFile fileName="Enums.FTX"/>
    <IncludeFile fileName="Teams.FTX"/>
  </Includes>
  <schemas>
    <schema name="League" assetId="9001" ownerAssetId="0" numMembers="1" base="Record">
      <attribute idx="0" name="Name" type="string" maxLen="16" default="NFL"/>
    </schema>
  </schemas>
</FranTkData>

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RecentFilesList > renders empty state when files is empty 1`] = `
<DocumentFragment>
  <div
    data-testid="empty-list-message"
    id="no-recent-files"
  >
    No recent files. When you open a file, it will appear here so you can access it later.
  </div>
</DocumentFragment>
`;

exports[`RecentFilesList > renders nothing if all files have no lastAccessedTime 1`] = `
<DocumentFragment>
  <div
    data-testid="List"
  />
</DocumentFragment>
`;


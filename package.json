{
  "name": "madden-franchise-editor",
  "version": "5.0.0",
  "description": "An app that can modify Madden franchise files.",
  "main": "main.js",
  "scripts": {
    "build:app": "npm run sass:build && npm run build:renderer && npm run build:react && electron-builder build -w",
    "build:renderer": "node scripts/build-renderer.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SASS,BNDL,ELEC\" -c \"magenta,blue,green\" \"npm run sass:dev\" \"npm run watch:renderer\" \"npm run dev:wait-and-start\"",
    "dev:electron": "cross-env NODE_ENV=development MFE_UI=v4 electron .",
    "dev:wait-and-start": "wait-on scripts/.watcher-ready && npm run dev:electron",
    "perf:startup": "node scripts/perf-startup.js",
    "e2eTest": "npm run sass:build && npm run build:renderer && npm run build:react && npx playwright test",
    "e2eTest:react": "npm run build:react && npx playwright test --project=react",
    "e2eTest:quick": "npm run build:react && cross-env E2E_QUICK=1 npx playwright test",
    "postinstall": "patch-package",
    "prepare": "git config core.hooksPath .githooks",
    "sass:build": "sass renderer/sass/app-manifest.scss renderer/css/app-manifest.css --no-source-map",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "sass:dev": "sass renderer/sass/app-manifest.scss renderer/css/app-manifest.css --source-map --watch",
    "watch:renderer": "node scripts/build-renderer.js --watch",
    "build-storybook": "storybook build",
    "build:react": "vite build",
    "dev:react": "concurrently -k -p \"[{name}]\" -n \"VITE,ELEC\" -c \"blue,green\" \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development MFE_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "format": "prettier --write src",
    "lint": "eslint src",
    "start:react": "cross-env MFE_UI=react electron .",
    "storybook": "storybook dev -p 6006",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "test:react": "vitest run",
    "typecheck": "tsc -b"
  },
  "author": "bep713",
  "license": "MIT",
  "homepage": "https://github.com/bep713/madden-franchise-editor",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@handsontable/react-wrapper": "^16.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.25.0",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "allotment": "^1.20.6",
    "browserify": "^17.0.1",
    "chai": "^4.3.4",
    "cheerio": "^1.0.0-rc.10",
    "classnames": "^2.5.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "debug": "^4.3.3",
    "electron": "^41.0.3",
    "electron-builder": "26.15.3",
    "electron-reload": "^1.5.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.3",
    "fuse.js": "^7.5.0",
    "globals": "^17.13.0",
    "handsontable": "^16.2.0",
    "handsontable-v11": "npm:handsontable@^11.1.0",
    "jsdom": "^29.1.1",
    "monaco-editor": "^0.57.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "sass": "^1.101.0",
    "storybook": "^10.6.3",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.10",
    "watchify": "^4.0.0"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^4.6.1",
    "fast-xml-parser": "5.2.5",
    "madden-franchise": "^4.4.1",
    "moment": "^2.29.4",
    "stream-parser": "^0.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.github.bep713.maddenfranchiseeditor",
    "productName": "Madden Franchise Editor",
    "files": [
      "package.json",
      "main.js",
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "out/renderer/**/*",
      "!renderer/sass{,/**/*}",
      "data/**/*",
      "!data/schemas{,/**/*}",
      "schedules/**/*",
      "!node_modules/moment/{locale,min,dist,src}{,/**/*}",
      "!node_modules/xlsx/{bin,types}{,/**/*}",
      "!node_modules/xlsx/{xlsx.mjs,xlsxworker.js,bower.json,CHANGELOG.md,README.md}",
      "!node_modules/xlsx/dist/{*.min.js,*.min.map,xlsx.extendscript.js,xlsx.zahl.js,xlsx.zahl.mjs,cpexcel.full.mjs,*.d.ts}"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "renderer/img/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "bep713",
          "repo": "madden-franchise-editor"
        }
      ]
    },
    "nsis": {
      "artifactName": "Madden-Franchise-Editor-Setup-${version}.${ext}"
    },
    "electronVersion": "41.0.3"
  }
}

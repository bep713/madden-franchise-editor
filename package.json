{
  "name": "madden-franchise-editor",
  "version": "4.6.0",
  "description": "An app that can modify Madden franchise files.",
  "main": "main.js",
  "scripts": {
    "build:app": "npm run sass:build && npm run build:renderer && electron-builder build -w",
    "build:renderer": "node scripts/build-renderer.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SASS,BNDL,ELEC\" -c \"magenta,blue,green\" \"npm run sass:dev\" \"npm run watch:renderer\" \"npm run dev:wait-and-start\"",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:wait-and-start": "wait-on scripts/.watcher-ready && npm run dev:electron",
    "perf:startup": "node scripts/perf-startup.js",
    "e2eTest": "npm run sass:build && npm run build:renderer && npx playwright test",
    "postinstall": "patch-package",
    "prepare": "git config core.hooksPath .githooks",
    "sass:build": "sass renderer/sass/app-manifest.scss renderer/css/app-manifest.css --no-source-map",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "sass:dev": "sass renderer/sass/app-manifest.scss renderer/css/app-manifest.css --source-map --watch",
    "watch:renderer": "node scripts/build-renderer.js --watch"
  },
  "author": "bep713",
  "license": "MIT",
  "homepage": "https://github.com/bep713/madden-franchise-editor",
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@playwright/test": "^1.25.0",
    "browserify": "^17.0.1",
    "chai": "^4.3.4",
    "cheerio": "^1.0.0-rc.10",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "debug": "^4.3.3",
    "electron": "^41.0.3",
    "electron-builder": "26.15.3",
    "electron-reload": "^1.5.0",
    "esbuild": "0.28.2",
    "handsontable": "11.1.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.59.1",
    "sass": "^1.101.0",
    "wait-on": "^9.0.10",
    "watchify": "^4.0.0"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^4.6.1",
    "madden-franchise": "^4.3.6",
    "moment": "^2.29.4",
    "stream-parser": "^0.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.github.bep713.maddenfranchiseeditor",
    "productName": "Madden Franchise Editor",
    "files": [
      "package.json",
      "main.js",
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "!renderer/sass{,/**/*}",
      "data/**/*",
      "!data/schemas{,/**/*}",
      "schedules/**/*",
      "!node_modules/moment/{locale,min,dist,src}{,/**/*}",
      "!node_modules/xlsx/{bin,types}{,/**/*}",
      "!node_modules/xlsx/{xlsx.mjs,xlsxworker.js,bower.json,CHANGELOG.md,README.md}",
      "!node_modules/xlsx/dist/{*.min.js,*.min.map,xlsx.extendscript.js,xlsx.zahl.js,xlsx.zahl.mjs,cpexcel.full.mjs,*.d.ts}"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "renderer/img/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "bep713",
          "repo": "madden-franchise-editor"
        }
      ]
    },
    "nsis": {
      "artifactName": "Madden-Franchise-Editor-Setup-${version}.${ext}"
    },
    "electronVersion": "41.0.3"
  }
}
